# Per-host values for the STUN server. install.sh keeps them in
# /etc/hushsend-stun/stun.env (root, 0600); on a first install it writes that
# file from its --realm / --port / --tls-port / --external-ip options.
# Plain KEY=value lines, no inline comments. There is no secret in this service.

# The hostname clients are given (VITE_STUN_URLS in hushsend's deploy/build-env.sh).
REALM=stun.example.org
# 3478 is the standard port. Use another one only on a host where something else
# (a TURN relay, say) already holds 3478 — on laptop-server this server takes 3479.
LISTEN_PORT=3478
# Nothing listens here without a certificate; it only must not collide.
TLS_LISTEN_PORT=5349
# Behind NAT: PUBLIC/PRIVATE, e.g. 203.0.113.7/192.168.1.19. Empty on a host
# that has its public address on an interface.
EXTERNAL_IP=
